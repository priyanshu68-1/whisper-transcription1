# Google Gemini API Key for transcription analysis, summarization, action items, and RAG search
GEMINI_API_KEY=your_gemini_api_key_here

# Bearer / X-API-Key token for REST API authentication (default: truthshield-secret-token-2026)
API_AUTH_TOKEN=truthshield-secret-token-2026

# SQLite Knowledge Repository Database path (default: whisper_meetings.db)
DATABASE_PATH=whisper_meetings.db
